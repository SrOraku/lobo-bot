# ============================================================
# 🌹ᵇᵒᵗঔৣ‌ʟᴏʙᴏ⟠̾♆̶🐺̑ — CONFIGURAÇÕES
# Dev: 🌹♆̽Ø᩺Ɍͬ₳Ꮶび᭄🐺
# Contato do criador: comando !criador
# ============================================================

# ── OBRIGATÓRIO ─────────────────────────────────────────────
# Número do dono do bot (com DDI, sem + ou espaços)
# Instalações de terceiros: configure o SEU dono antes de conectar.
# Defina o número que terá autoridade de dono nesta instalação.
# Se ficar vazio, node src/index.js pede o número no console no primeiro início
# e salva em data/bot-owner.json (privado). BOT_OWNER preenchido tem prioridade.
# Para trocar o dono salvo, apague data/bot-owner.json e reinicie.
# O criador do bot (veja !criador) é dono absoluto em qualquer instalação,
# além deste dono; ele nunca vira o dono principal sozinho.
# Cada comprador cadastra aqui ou no console o próprio número e administra
# sua instalação com os comandos de dono, sem autorização manual do criador.
BOT_OWNER=
# Donos adicionais opcionais (DDI e número, separados por vírgula).
BOT_OWNERS=

# O WhatsApp de conexão é escolhido no console a cada novo emparelhamento.

# ── IDENTIDADE ───────────────────────────────────────────────
BOT_NAME=🌹ᵇᵒᵗঔৣ‌ʟᴏʙᴏ⟠̾♆̶🐺̑
BOT_DESCRIPTION=🌹𝕹ã𝖔 𝖒𝖊𝖝𝖆 𝖈𝖔𝖒 𝖚𝖒 𝖑𝖔𝖇𝖔 𝖆𝖘𝖘𝖎𝖒 𝖓ã𝖔 𝖕𝖊𝖗𝖆 𝖓𝖔𝖘𝖘𝖆 𝖎𝖗á🐺
DEVELOPER_NAME=🌹♆̽Ø᩺Ɍͬ₳Ꮶび᭄🐺
DEVELOPER_CONTACT=
PREFIX=!
SESSION_NAME=lobo-bot-session

# ── FIGURINHAS ───────────────────────────────────────────────
# Nome do pacote e autor gravados em toda figurinha (!s, !sfundo, animadas).
# Marcadores: {nome} = quem pediu, {grupo} = nome do grupo, {bot} = BOT_NAME,
# {dono} = DEVELOPER_NAME, {data} = data de hoje (dd/mm/aaaa, horário de Brasília).
# "!s pacote | autor" troca os dois apenas naquela figurinha.
STICKER_PACK={bot}
STICKER_AUTHOR=Pedido por {nome}

# ── REMOÇÃO DE FUNDO (!sfundo) ───────────────────────────────
# medium = ISNet FP16, recorte mais fiel em cabelo e bordas (padrão).
# small  = modelo menor; use em hospedagens com pouca memória.
# Valor inválido volta para medium; se os arquivos do modelo escolhido
# estiverem incompletos, o bot usa o outro automaticamente.
SFUNDO_MODEL=medium

# ── JOGO 100 LOBISOMENS ──────────────────────────────────────
GOLD_START=500
BATTLE_TIMEOUT=60

# ── SISTEMA DE XP ────────────────────────────────────────────
XP_PER_MESSAGE=5
XP_PREMIUM_MULTIPLIER=2
XP_COOLDOWN_SEC=30

# ── MODERAÇÃO ────────────────────────────────────────────────
ANTILINK_MODE=delete
INACTIVITY_DAYS=7

# ── ANTI-FLOOD ───────────────────────────────────────────────
CMD_COOLDOWN_MS=1500

# ── RECONEXÃO ────────────────────────────────────────────────
MAX_RECONNECT=10

# ── CACHE / REDIS (opcional — deixe vazio para usar memória) ─
REDIS_URL=

# ── LOGS ─────────────────────────────────────────────────────
# Valores: debug | info | warn | error
LOG_LEVEL=info
# Resumos de comandos (sem argumentos/conteúdo das mensagens) e status de conexão.
LOG_COMMANDS=true
NODE_ENV=production

# ── APIs OPCIONAIS ───────────────────────────────────────────
YOUTUBE_API_KEY=

# API Bronxys opcional: nunca publique sua chave real
BRONXYS_API_KEY=

# LOBO-BOT LICENSE — deixe vazio para manter o modo atual sem licenciamento.
# Configure somente após criar uma credencial no painel Base44.
LOBO_API_URL=
LOBO_LICENSE_KEY=
# O installation_id é gerado e persistido automaticamente em data/; não precisa preencher.

# Integrações opcionais. Não publique chaves reais.
LASTFM_API_KEY=
ASSEMBLYAI_API_KEY=

# ── LOBO BOT CONTROL CENTER ──────────────────────────────────
# URL pública HTTPS do backend/Edge Functions do Control Center.
# Deixe URL e token vazios para manter a integração desativada.
CONTROL_CENTER_URL=

# Token de ENROLLMENT emitido pela central para registrar automaticamente
# instalações/grupos. Nunca publique o valor real no GitHub.
CONTROL_CENTER_ENROLLMENT_TOKEN=

# Política quando a central estiver temporariamente indisponível.
# closed = bloqueia funções protegidas depois da janela de tolerância.
# open   = permite uso durante a indisponibilidade.
CONTROL_CENTER_FAIL_MODE=closed

# Heartbeat e cache de validação (milissegundos).
CONTROL_CENTER_HEARTBEAT_MS=60000
CONTROL_CENTER_VALIDATE_TTL_MS=60000
CONTROL_CENTER_GRACE_MS=300000
CONTROL_CENTER_TIMEOUT_MS=8000
